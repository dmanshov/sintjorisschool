# ─────────────────────────────────────────────────────────────────────────────
# Sint-Jorisschool — environment
# Copy to .env.local for development. Never commit a filled-in copy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Neon Postgres ────────────────────────────────────────────────────────────
# This site MUST live in its own Neon PROJECT, not merely its own database
# inside a project shared with something else. A second database in the same
# project still shares the compute endpoint, the Postgres roles, the branch and
# the PITR window — so one leaked credential reaches both, and a branch reset on
# the other application takes this one with it.
#
# Create: Neon console → New project → name "sintjorisschool", region
# eu-central-1 (Frankfurt), database name "sintjorisschool".
#
# Use the POOLED connection string for the app (host contains "-pooler").
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/sintjorisschool?sslmode=require"
# Unpooled/direct connection, used by migrations and the bulk import scripts.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/sintjorisschool?sslmode=require"

# ── Isolation guardrails ─────────────────────────────────────────────────────
# Every script refuses to run unless all of these hold. They exist because our
# table names (users, posts, orders, content, sessions) are generic enough to
# collide with any other application, so a connection string pasted from the
# wrong Neon project would half-apply instead of failing.
#
#   1. current_database() equals EXPECTED_DATABASE_NAME
#   2. the public schema contains only this project's tables
#   3. the connection host equals EXPECTED_DATABASE_HOST, when it is set
#
# Set the host pin as soon as the Neon project exists. It is the check that
# actually enforces "this project and no other": a different endpoint is a
# different Neon project, even if the database inside it shares a name, and an
# empty database of the right name would pass checks 1 and 2 on its own.
# Copy the host out of DATABASE_URL_UNPOOLED — hostname only, no protocol,
# no port, no database.
EXPECTED_DATABASE_NAME="sintjorisschool"
EXPECTED_DATABASE_HOST=""     # e.g. ep-xxx.eu-central-1.aws.neon.tech

# Optional override for the address this deployment answers on, no trailing
# slash. Leave it UNSET — that is the normal setting, not a placeholder to fill
# in. The app builds every absolute URL it needs (the link in a password-reset
# email, the canonical and Open Graph tags, the sitemap, the structured data on
# /contact) from the incoming request's own Host header instead, so it works
# correctly on whatever address is actually serving it — a Vercel preview URL,
# the *.vercel.app production URL, or a custom domain — with nothing to update
# when that address changes.
#
# This does NOT control who can reach the site, and setting it does not point
# any domain at this deployment; only DNS does that.
#
# Set it only if requests arrive through something that strips or rewrites the
# standard forwarded-host headers (an unusual proxy setup). If you do set it,
# use the address this deployment is actually reachable at — pointing it at a
# domain that resolves elsewhere sends password-reset links to the wrong site.
# NEXT_PUBLIC_SITE_URL="https://example.com"

# ── Staging lock ─────────────────────────────────────────────────────────────
# While this is set, the entire site sits behind a browser password prompt and
# is marked noindex, so it can be finished in the open without school members or
# search engines finding it. Any username works; this value is the password.
# Remove the variable and redeploy to make the site public. There is no second
# switch to remember.
#
# This is separate from the login on /profiel and /admin, which protects real
# accounts and personal data and applies either way.
SITE_ACCESS_CODE=""

# 32+ random bytes, base64. Signs session cookies. Rotating it logs everyone out.
#   openssl rand -base64 48
SESSION_SECRET=""

# ── Firebase Auth password compatibility ─────────────────────────────────────
# Firebase Console → Authentication → Users → ⋮ (top right of the table)
# → "Password hash parameters". Copy all four values verbatim.
# Without these, existing users cannot log in with their current password.
FIREBASE_HASH_SIGNER_KEY=""      # base64, long
FIREBASE_HASH_SALT_SEPARATOR=""  # base64, usually "Bw=="
FIREBASE_HASH_ROUNDS="8"
FIREBASE_HASH_MEM_COST="14"

# ── Outbound email (password reset, welcome) ─────────────────────────────────
# MAIL_DRIVER: smtp | console   (console logs the mail instead of sending)
MAIL_DRIVER="console"
MAIL_FROM="Sint-Jorisschool <noreply@sintjorisschool.be>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ── Media storage (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2, MinIO) ─
# Only needed for NEW uploads. Existing Firebase Storage URLs keep working.
S3_ENDPOINT=""                   # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL that serves the bucket, no trailing slash.
NEXT_PUBLIC_MEDIA_BASE_URL=""    # e.g. https://media.example.com
NEXT_PUBLIC_MEDIA_HOST=""        # hostname only, for the next/image allowlist

# ── Migration scripts only (never needed by the running site) ────────────────
# Path to a Firebase service account JSON with Firestore + Storage read access.
FIREBASE_SERVICE_ACCOUNT_PATH="./migration-data/serviceAccount.json"
FIREBASE_STORAGE_BUCKET="sintjorisschool-3390.appspot.com"
# Output of:  firebase auth:export migration-data/firebase-users.json --format=json
FIREBASE_AUTH_EXPORT_PATH="./migration-data/firebase-users.json"
