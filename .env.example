# ─────────────────────────────────────────────────────────────────────────────
# Sint-Jorisschool — environment
# Copy to .env.local for development. Never commit a filled-in copy.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres. Use the POOLED connection string for the app (…-pooler…).
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/sintjorisschool?sslmode=require"
# Unpooled/direct connection, used by migrations and the bulk import scripts.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/sintjorisschool?sslmode=require"

# Public origin, used for absolute links in emails and canonical tags.
NEXT_PUBLIC_SITE_URL="https://www.sintjorisschool.be"

# 32+ random bytes, base64. Signs session cookies. Rotating it logs everyone out.
#   openssl rand -base64 48
SESSION_SECRET=""

# ── Firebase Auth password compatibility ─────────────────────────────────────
# Firebase Console → Authentication → Users → ⋮ (top right of the table)
# → "Password hash parameters". Copy all four values verbatim.
# Without these, existing users cannot log in with their current password.
FIREBASE_HASH_SIGNER_KEY=""      # base64, long
FIREBASE_HASH_SALT_SEPARATOR=""  # base64, usually "Bw=="
FIREBASE_HASH_ROUNDS="8"
FIREBASE_HASH_MEM_COST="14"

# ── Outbound email (password reset, welcome) ─────────────────────────────────
# MAIL_DRIVER: smtp | console   (console logs the mail instead of sending)
MAIL_DRIVER="console"
MAIL_FROM="Sint-Jorisschool <noreply@sintjorisschool.be>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ── Media storage (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2, MinIO) ─
# Only needed for NEW uploads. Existing Firebase Storage URLs keep working.
S3_ENDPOINT=""                   # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL that serves the bucket, no trailing slash.
NEXT_PUBLIC_MEDIA_BASE_URL=""    # e.g. https://media.sintjorisschool.be
NEXT_PUBLIC_MEDIA_HOST=""        # hostname only, for the next/image allowlist

# ── Migration scripts only (never needed by the running site) ────────────────
# Path to a Firebase service account JSON with Firestore + Storage read access.
FIREBASE_SERVICE_ACCOUNT_PATH="./migration-data/serviceAccount.json"
FIREBASE_STORAGE_BUCKET="sintjorisschool-3390.appspot.com"
# Output of:  firebase auth:export migration-data/firebase-users.json --format=json
FIREBASE_AUTH_EXPORT_PATH="./migration-data/firebase-users.json"
